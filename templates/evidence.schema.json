{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Evidence",
  "type": "object",
  "required": [
    "run_id",
    "step",
    "status",
    "evidence_refs"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "BLOCKED",
        "SKIPPED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
